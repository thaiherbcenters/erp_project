            items: items.filter(i => i.name).map(i => ({
                name: i.name,
                qty: Number(i.qty) || 0,
                price: Number(i.price) || 0,
                amount: i.isPromo ? 1000 * (Number(i.promoMultiplier) || 1) : (Number(i.qty) || 0) * (Number(i.price) || 0),
