                    </button>
                    </div>{/* end q-section 3 */}

                    {/* ===== Section 5: à¸•à¸±à¹‰à¸‡à¸„à¹ˆà¸²à¹€à¸­à¸à¸ªà¸²à¸£ ===== */}
                    <div className="q-section q-section--settings">
