                                        {((item.isPromo || item.promoType)
                                            ? (1000 * (parseInt(item.promoMultiplier) || 1))
                                            : ((parseFloat(item.qty) || 0) * (parseFloat(item.price) || 0))
                                        ).toLocaleString('th-TH', { minimumFractionDigits: 2 })}
                                    </td>
                                </tr>
                            ))}
                            {items.filter(it => it.name).length === 0 && (
                                <tr>
                                    <td colSpan="7" style={{ height: '50px', textAlign: 'center', borderBottom: 'none' }}>à¹„à¸¡à¹ˆà¸¡à¸µà¸£à¸²à¸¢à¸à¸²à¸£à¸ªà¸´à¸™à¸„à¹‰à¸²</td>
                                </tr>
                            )}
                        </tbody>
                        
                        {/* Footer enclosed within the same rounded box */}
